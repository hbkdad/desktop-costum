<Window
    x:Class="WinUiFeasibilityProbe.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Desktop Runtime — WinUI 3 feasibility probe">

    <StackPanel Padding="32" Spacing="12" VerticalAlignment="Center">
        <TextBlock x:Name="Headline"
                   Text="WinUI 3 is running."
                   FontSize="28"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="Detail"
                   Text="Closing automatically…"
                   Opacity="0.7" />
    </StackPanel>
</Window>
